//@version=5
indicator("SMC Assistant Prototype", shorttitle="SMC Assistant", overlay=true, max_labels_count=500, max_boxes_count=100)

leftBars = input.int(5, "Left bars", minval=1, maxval=20)
rightBars = input.int(5, "Right bars", minval=1, maxval=20)
breakBufferTicks = input.int(0, "Break buffer ticks", minval=0, maxval=100)
sweepBufferTicks = input.int(0, "Sweep buffer ticks", minval=0, maxval=100)
useCloseConfirmation = input.bool(true, "Use close confirmation")
showSwings = input.bool(false, "Show swings")
showBosLabels = input.bool(false, "Show BOS labels")
showChochLabels = input.bool(true, "Show CHoCH labels")
showFvgs = input.bool(true, "Show FVGs")
showOnlySetupFvgs = input.bool(true, "Only setup FVGs")
showSweeps = input.bool(false, "Show liquidity sweeps")
showDisplacement = input.bool(false, "Show displacement")
htfTimeframe = input.timeframe("15", "HTF timeframe")
strategyVersion = input.string("smc-rce-v1", "Strategy version")
fvgMinTicks = input.int(5, "Min FVG size ticks", minval=0, maxval=1000)
fvgProjectionBars = input.int(12, "FVG projection bars", minval=1, maxval=100)
atrPeriod = input.int(14, "ATR period", minval=2, maxval=100)
bodyAtrThreshold = input.float(0.7, "Body/ATR threshold", minval=0.1, maxval=10.0)
bodyToRangeThreshold = input.float(0.55, "Body/range threshold", minval=0.1, maxval=1.0)
displacementThreshold = input.float(0.65, "Displacement score threshold", minval=0.0, maxval=1.0)

breakBuffer = syminfo.mintick * breakBufferTicks
sweepBuffer = syminfo.mintick * sweepBufferTicks
fvgMinSize = syminfo.mintick * fvgMinTicks

var float lastSwingHighPrice = na
var int lastSwingHighBar = na
var float lastSwingLowPrice = na
var int lastSwingLowBar = na
var int brokenSwingHighBar = na
var int brokenSwingLowBar = na
var int marketBias = 0

pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow = ta.pivotlow(low, leftBars, rightBars)

if not na(pivotHigh)
    lastSwingHighPrice := pivotHigh
    lastSwingHighBar := bar_index - rightBars
    if showSwings
        label.new(lastSwingHighBar, pivotHigh, "SH", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny)

if not na(pivotLow)
    lastSwingLowPrice := pivotLow
    lastSwingLowBar := bar_index - rightBars
    if showSwings
        label.new(lastSwingLowBar, pivotLow, "SL", style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.tiny)

bullishBreakPrice = useCloseConfirmation ? close : high
bearishBreakPrice = useCloseConfirmation ? close : low

bullishBos = not na(lastSwingHighPrice) and bar_index > lastSwingHighBar and bullishBreakPrice > lastSwingHighPrice + breakBuffer and brokenSwingHighBar != lastSwingHighBar
bearishBos = not na(lastSwingLowPrice) and bar_index > lastSwingLowBar and bearishBreakPrice < lastSwingLowPrice - breakBuffer and brokenSwingLowBar != lastSwingLowBar

bullishChoch = bullishBos and marketBias == -1
bearishChoch = bearishBos and marketBias == 1

if bullishBos
    brokenSwingHighBar := lastSwingHighBar
    marketBias := 1
    if (bullishChoch and showChochLabels) or (not bullishChoch and showBosLabels)
        label.new(bar_index, high, bullishChoch ? "CHoCH" : "BOS", style=label.style_label_down, color=bullishChoch ? color.new(color.yellow, 0) : color.new(color.blue, 0), textcolor=color.black, size=size.small)

if bearishBos
    brokenSwingLowBar := lastSwingLowBar
    marketBias := -1
    if (bearishChoch and showChochLabels) or (not bearishChoch and showBosLabels)
        label.new(bar_index, low, bearishChoch ? "CHoCH" : "BOS", style=label.style_label_up, color=bearishChoch ? color.new(color.yellow, 0) : color.new(color.purple, 0), textcolor=color.white, size=size.small)

bullishFvg = low > high[2] and low - high[2] >= fvgMinSize
bearishFvg = high < low[2] and low[2] - high >= fvgMinSize
activeBullishSetup = bullishChoch and bullishFvg
activeBearishSetup = bearishChoch and bearishFvg
showBullishFvgBox = showFvgs and bullishFvg and (not showOnlySetupFvgs or activeBullishSetup)
showBearishFvgBox = showFvgs and bearishFvg and (not showOnlySetupFvgs or activeBearishSetup)

if showBullishFvgBox
    box.new(left=bar_index - 2, top=low, right=bar_index + fvgProjectionBars, bottom=high[2], bgcolor=color.new(color.teal, 88), border_color=color.new(color.teal, 45))

if showBearishFvgBox
    box.new(left=bar_index - 2, top=low[2], right=bar_index + fvgProjectionBars, bottom=high, bgcolor=color.new(color.orange, 88), border_color=color.new(color.orange, 45))

bullishSweep = not na(lastSwingLowPrice) and low < lastSwingLowPrice - sweepBuffer and close > lastSwingLowPrice
bearishSweep = not na(lastSwingHighPrice) and high > lastSwingHighPrice + sweepBuffer and close < lastSwingHighPrice

if showSweeps and bullishSweep
    label.new(bar_index, low, "Sweep", style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)

if showSweeps and bearishSweep
    label.new(bar_index, high, "Sweep", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

priorAtr = ta.atr(atrPeriod)[1]
candleBody = math.abs(close - open)
candleRange = high - low
bodyAtrRatio = priorAtr > 0 ? candleBody / priorAtr : 0.0
bodyToRangeRatio = candleRange > 0 ? candleBody / candleRange : 0.0
bodyAtrScore = math.min(bodyAtrRatio / bodyAtrThreshold, 1.0)
bodyToRangeScore = math.min(bodyToRangeRatio / bodyToRangeThreshold, 1.0)
displacementScore = (bodyAtrScore + bodyToRangeScore) / 2.0
isBullishDisplacement = close > open and displacementScore >= displacementThreshold
isBearishDisplacement = close < open and displacementScore >= displacementThreshold

plotshape(showDisplacement and isBullishDisplacement, title="Bullish displacement", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.tiny)
plotshape(showDisplacement and isBearishDisplacement, title="Bearish displacement", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

setupDirection = activeBullishSetup ? "LONG" : activeBearishSetup ? "SHORT" : ""
setupCandidate = setupDirection != ""
htfBias = marketBias == 1 ? "BULLISH" : marketBias == -1 ? "BEARISH" : "NEUTRAL"
sessionName = session.ismarket ? "NEW_YORK" : "OFF_HOURS"
eventId = syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time_close) + "-" + setupDirection
activeFvgLower = activeBullishSetup ? high[2] : activeBearishSetup ? high : na
activeFvgUpper = activeBullishSetup ? low : activeBearishSetup ? low[2] : na
activeFvgEquilibrium = (activeFvgLower + activeFvgUpper) / 2.0
setupEntry = activeFvgEquilibrium
setupStopLoss = activeBullishSetup ? activeFvgLower - syminfo.mintick : activeBearishSetup ? activeFvgUpper + syminfo.mintick : na
setupRisk = math.abs(setupEntry - setupStopLoss)
setupTakeProfit = activeBullishSetup ? setupEntry + setupRisk * 2.0 : activeBearishSetup ? setupEntry - setupRisk * 2.0 : na
setupRiskReward = setupRisk > 0 ? math.abs(setupTakeProfit - setupEntry) / setupRisk : na

alertPayload = '{"schemaVersion":"1.0",'
alertPayload := alertPayload + '"eventId":"' + eventId + '",'
alertPayload := alertPayload + '"eventType":"SETUP_CANDIDATE",'
alertPayload := alertPayload + '"source":"TRADINGVIEW",'
alertPayload := alertPayload + '"strategyVersion":"' + strategyVersion + '",'
alertPayload := alertPayload + '"symbol":"' + syminfo.ticker + '",'
alertPayload := alertPayload + '"exchange":"' + syminfo.prefix + '",'
alertPayload := alertPayload + '"timeframe":"' + timeframe.period + '",'
alertPayload := alertPayload + '"barOpenTime":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",'
alertPayload := alertPayload + '"barCloseTime":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",'
alertPayload := alertPayload + '"direction":"' + setupDirection + '",'
alertPayload := alertPayload + '"marketStructure":{"htfTimeframe":"' + htfTimeframe + '","htfBias":"' + htfBias + '","bos":' + str.tostring(bullishBos or bearishBos) + ',"choch":' + str.tostring(bullishChoch or bearishChoch) + ',"liquiditySweep":' + str.tostring(bullishSweep or bearishSweep) + '},'
alertPayload := alertPayload + '"fvg":{"lower":' + str.tostring(activeFvgLower) + ',"upper":' + str.tostring(activeFvgUpper) + ',"equilibrium":' + str.tostring(activeFvgEquilibrium) + ',"sizeAtrRatio":0.0,"mitigationPercent":0.0},'
alertPayload := alertPayload + '"execution":{"entry":' + str.tostring(setupEntry) + ',"stopLoss":' + str.tostring(setupStopLoss) + ',"takeProfit":' + str.tostring(setupTakeProfit) + ',"riskReward":' + str.tostring(setupRiskReward) + '},'
alertPayload := alertPayload + '"features":{"atr":' + str.tostring(priorAtr) + ',"relativeVolume":null,"displacementScore":' + str.tostring(displacementScore) + ',"session":"' + sessionName + '"}}'

if setupCandidate
    alert(alertPayload, alert.freq_once_per_bar_close)
